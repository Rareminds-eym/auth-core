{
  "name": "@rareminds-eym/auth-core",
  "version": "3.0.0",
  "description": "Production-grade core authentication logic and utilities for Rareminds SSO",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rareminds-eym/auth-core.git"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run tests/property/*.property.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jose": "6.2.8"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260511.1",
    "@vitest/coverage-istanbul": "3.2.7",
    "fast-check": "4.9.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
